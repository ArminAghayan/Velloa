rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Rules for the users collection
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null;
      allow update, delete: if request.auth != null && request.auth.uid == userId;
    }
    
    // Rules for the companies collection
    match /companies/{companyId} {
      // Allow authenticated users to create new company documents
      allow create: if request.auth != null;
      // Allow read access if the user is the company owner or a member
      allow read: if request.auth != null && (request.auth.uid == resource.data.owner_id || request.auth.uid in resource.data.members);
      // Allow update and delete access if the user is the company owner
      allow update, delete: if request.auth != null && request.auth.uid == resource.data.owner_id;
    }
    
    // Rules for the properties collection
    match /properties/{propertyID} {
      // Allow create access if the user is authenticated
      allow create: if request.auth != null;
      // Allow read access if the user is authenticated and a member of the associated company
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/companies/$(resource.data.companyuid)).data.members;
      // Allow update and delete access if the user is authenticated and a member of the associated company
      allow update, delete: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/companies/$(resource.data.companyuid)).data.members;
      
      // Rules for the applications subcollection
      match /applications/{applicationID} {
        allow read, create, update, delete: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/companies/$(get(/databases/$(database)/documents/properties/$(propertyID)).data.companyuid)).data.members;
      }
    }
    
    // Rules for the units collection
    match /units/{unitID} {
      // Allow read access if the user is authenticated and a member of the associated company
      allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/companies/$(resource.data.companyuid)).data.members;
      // Allow create access if the user is authenticated
      allow create: if request.auth != null;
      // Allow update and delete access if the user is authenticated and a member of the associated company
      allow update, delete: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/companies/$(resource.data.companyuid)).data.members;
    }
    
    // Rules for the default forms collection
    match /default_forms/{formID} {
      // Allow read access to everyone
      allow read: if true;
    }
  }
}